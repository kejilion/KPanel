[Unit]
Description=KPanel Host Agent
Documentation=https://hub.docker.com/r/kjlion/kejilion-panel
After=local-fs.target

[Service]
Type=simple
User=root
Group=kejilion-panel
EnvironmentFile=-/etc/kejilion-panel/agent.env
ExecStart=/usr/local/libexec/kejilion-agent
Restart=on-failure
RestartSec=3s
RuntimeDirectory=kejilion-panel
RuntimeDirectoryMode=0750
# The Panel data directory is owned by the container UID/GID. Do not declare
# its parent as StateDirectory: systemd would recursively change that ownership.
UMask=0077

NoNewPrivileges=true
# Kejilion site trees may be owned by the script's invoking user. DAC override
# remains bounded to this service and the explicit writable paths below.
# CAP_SYS_PTRACE lets the fixed, read-only ss adapter resolve socket owners;
# without it systemd strips users:((...)) metadata even when ss runs as root.
# CAP_KILL is used with pidfds to stop only the pinned Docker terminal shell,
# including containers whose configured user differs from the Agent's UID.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_MODULE CAP_NET_ADMIN CAP_SYS_RESOURCE CAP_DAC_OVERRIDE CAP_CHOWN CAP_LINUX_IMMUTABLE CAP_SYS_PTRACE CAP_KILL
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_MODULE CAP_NET_ADMIN CAP_SYS_RESOURCE CAP_DAC_OVERRIDE CAP_CHOWN CAP_LINUX_IMMUTABLE CAP_SYS_PTRACE CAP_KILL
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=false
ProtectKernelLogs=true
ProtectKernelModules=false
ProtectKernelTunables=false
# Docker socket activation guard verifies /run/docker.pid against /proc/<pid>/comm.
ProtectProc=default
# The file manager is deliberately rooted at /. ProtectSystem=strict remounts
# that root read-only, and ReadWritePaths=/ does not reverse the remount on all
# supported systemd releases. The typed, audited file API is the write boundary;
# keep its managed root writable while protecting Panel state explicitly below.
ProtectSystem=false
ProtectHome=false
ReadOnlyPaths=/var/lib/kejilion-panel/panel
# System actions need atomic rename transactions below /etc. The application
# market and file manager write only through audited, fixed Agent adapters.
# The fixed file API independently rejects KPanel data paths, symlinks and
# writes to kernel virtual filesystems.
# iptables-nft talks to the kernel through netlink. Keep that family available
# so Docker access rules work inside the otherwise restricted service sandbox.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service @module @swap sethostname
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
