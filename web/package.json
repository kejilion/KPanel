    "test:watch": "vitest",
    "build": "npm run i18n:check && npm run typecheck && vite build && node scripts/precompress.mjs",
    "scene-packs:build": "tsc -p ../scene-packs/tsconfig.json && node scripts/build-scene-packs.mjs",
    "scene-packs:check": "tsc -p ../scene-packs/tsconfig.json && node scripts/build-scene-packs.mjs --check"
