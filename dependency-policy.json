{
  "schemaVersion": 1,
  "policyVersion": "2026-09-05",
  "purpose": "Continuously detect version-channel-stable dependency candidates without turning freshness into automatic adoption.",
  "stableRelease": {
    "excludePrerelease": true,
    "excludeDraftOrWithdrawn": true,
    "nodeChannel": "latest-lts",
    "requireSupportedUpstream": true,
    "requireImmutableProductionPin": true
  },
  "cadence": {
    "scheduledDetectionCron": "17 2 * * 1",
    "scheduledDetectionMaximumDays": 7,
    "securityAdvisoryCron": "43 2 * * *",
    "securityAdvisoryMaximumHours": 24,
    "exceptionReviewMaximumDays": 31,
    "eolReviewMaximumDays": 92
  },
  "reviewState": {
    "lastEolReview": "2026-07-28",
    "eolReviewEvidence": "docs/security-performance-hardening-2026-07-28.md"
  },
  "detectorQualification": {
    "candidateLevel": "version-channel-stable",
    "adoptionEvidenceStillRequired": [
      "supported-upstream-and-eol",
      "license-and-source-trust",
      "kpanel-architecture-and-linux-support",
      "behavior-contract-and-resource-impact",
      "rollback-feasibility"
    ]
  },
  "adoptionLifecycle": {
    "actionableScopes": ["direct", "foundation"],
    "transitiveOwnership": "owning-direct-dependency-or-reachable-security-path",
    "deferralRequiresException": true,
    "resolutionDefinition": "adopt, reject with evidence, or create a time-bounded exception",
    "classes": {
      "emergency-security": {
        "evaluationStartMaximumDays": 1,
        "decisionMaximumDays": 3,
        "resolutionMaximumDays": 3,
        "minimumVerification": "L2-or-L3-and-section-11-vulnerability-deadline"
      },
      "compatible-patch": {
        "evaluationStartMaximumDays": 7,
        "decisionMaximumDays": 14,
        "resolutionMaximumDays": 30,
        "minimumVerification": "L1-or-L2-by-impact"
      },
      "minor": {
        "evaluationStartMaximumDays": 14,
        "decisionMaximumDays": 30,
        "resolutionMaximumDays": 60,
        "minimumVerification": "L2"
      },
      "major-toolchain-base": {
        "evaluationStartMaximumDays": 30,
        "decisionMaximumDays": 90,
        "resolutionMaximumDays": 90,
        "minimumVerification": "L2-or-L3"
      }
    },
    "batching": {
      "compatiblePatch": "same ecosystem and atomic rollback boundary",
      "minor": "same compatibility domain with explicit contract and resource comparison",
      "majorToolchainBase": "one compatibility domain per candidate; coupled adapters may travel together",
      "security": "do not wait for a routine batch when the vulnerability deadline is stricter"
    }
  },
  "crossRepositoryReleaseLinkage": {
    "schemaVersion": 1,
    "states": ["not-required", "coupled", "script-only"],
    "requiresExplicitDecision": true,
    "repositories": {
      "kpanel": {
        "name": "kejilion/KPanel",
        "versionSource": "VERSION"
      },
      "script": {
        "name": "kejilion/sh",
        "branch": "main",
        "revisionSource": "commit-and-content-digest"
      }
    },
    "decisionRules": {
      "not-required": {
        "when": "KPanel does not change or require a new or changed script-defined protocol, runtime action, host artifact, install/update path, external configuration, or embedded script content; an existing compatible contract is allowed",
        "requiredEvidence": ["candidate-diff-review", "baseline-script-commit-and-digest", "compatibility-check"],
        "kpanelReleaseAllowed": true,
        "scriptRelease": "not-in-scope"
      },
      "coupled": {
        "when": "KPanel changes or consumes a new or changed script-defined protocol, runtime action, host artifact, install/update path, external configuration, or embedded script content",
        "requiredEvidence": ["paired-change-set-id", "script-commit-and-digest", "root-cn-sync-check", "script-smoke", "kpanel-contract-tests", "cross-repo-compatibility", "paired-rollback"],
        "kpanelReleaseAllowed": "only-after-script-compatible-release",
        "scriptRelease": "required",
        "ifScriptNotReady": "block-kpanel-candidate-or-remove-dependent-scope"
      },
      "script-only": {
        "when": "Only kejilion/sh changes and the supported KPanel contract remains compatible without KPanel code, image, or configuration changes",
        "requiredEvidence": ["script-commit-and-digest", "root-cn-sync-check", "script-smoke", "supported-kpanel-compatibility", "script-rollback"],
        "kpanelReleaseAllowed": false,
        "scriptRelease": "required",
        "kpanelVersionChange": false
      }
    },
    "requiredDeliveryFields": [
      "scriptLinkageState",
      "changeSetId",
      "baselineScriptRevision",
      "baselineScriptSha256",
      "candidateScriptRevision",
      "candidateScriptSha256",
      "compatibilityEvidence",
      "releaseDecision"
    ],
    "releaseBlockers": [
      "coupled-without-script-compatible-revision",
      "coupled-without-paired-evidence",
      "not-required-without-baseline-script-proof",
      "script-only-with-kpanel-changes",
      "state-missing-or-contradictory"
    ]
  },
  "requiredGroups": [
    "go-modules",
    "npm-packages",
    "go-toolchain",
    "node-toolchain",
    "docker-base-images",
    "dockerfile-frontend",
    "github-actions",
    "security-tools",
    "managed-kejilion-script"
  ],
  "groups": [
    {
      "id": "go-modules",
      "scope": "direct-and-transitive",
      "manifests": ["go.mod", "go.sum"],
      "detector": "go-list"
    },
    {
      "id": "npm-packages",
      "scope": "production-and-development-direct-and-transitive",
      "manifests": ["web/package.json", "web/package-lock.json"],
      "detector": "npm-outdated-all"
    },
    {
      "id": "go-toolchain",
      "scope": "compiler-and-build-runtime",
      "manifests": ["go.mod", "Dockerfile", ".github/workflows/ci.yml", ".github/workflows/release.yml", ".codex-workflows"],
      "detector": "go-stable-releases"
    },
    {
      "id": "node-toolchain",
      "scope": "latest-supported-lts",
      "manifests": ["web/package.json", "Dockerfile", ".github/workflows/ci.yml", ".github/workflows/release.yml"],
      "detector": "node-lts-releases"
    },
    {
      "id": "docker-base-images",
      "scope": "build-images-and-pinned-index-digests",
      "manifests": ["Dockerfile"],
      "detector": "dockerfile-base-images"
    },
    {
      "id": "dockerfile-frontend",
      "scope": "stable-version-and-pinned-digest",
      "manifests": ["Dockerfile"],
      "detector": "docker-hub-tags"
    },
    {
      "id": "github-actions",
      "scope": "all-workflow-actions",
      "manifests": [".github/workflows"],
      "detector": "github-releases"
    },
    {
      "id": "security-tools",
      "scope": "govulncheck-and-trivy",
      "manifests": ["Makefile", ".github/workflows/ci.yml", ".github/workflows/release.yml", "scripts/security-scan.sh"],
      "detector": "github-releases",
      "components": {
        "trivy": {
          "repository": "aquasecurity/trivy",
          "currentVersion": "0.72.0",
          "pinnedDigest": "sha256:c6e969c5662a546ad5de4a73c2a6b7a7c627f86d916903e175aa623af5b97ada"
        },
        "govulncheck": {
          "repository": "golang/vuln"
        }
      }
    },
    {
      "id": "managed-kejilion-script",
      "scope": "upstream-commit-and-content-digest",
      "manifests": ["Dockerfile", "docs/external-config-sources.md"],
      "detector": "github-branch-head",
      "repository": "kejilion/sh",
      "branch": "main"
    }
  ],
  "adoptionClasses": [
    {
      "id": "emergency-security",
      "criteria": "actively exploited, withdrawn, or reachable critical/high vulnerability",
      "default": "immediate-triage-and-fix-or-mitigate",
      "minimumVerification": "L2-or-L3"
    },
    {
      "id": "compatible-patch",
      "criteria": "stable semantic patch within the supported compatibility line, including foundation components",
      "default": "follow-after-change-aware-verification",
      "minimumVerification": "L1-or-L2-by-impact; foundation components keep an L2-or-L3 floor"
    },
    {
      "id": "minor",
      "criteria": "stable semantic minor without a declared breaking contract, including foundation components",
      "default": "batch-and-adopt-after-benefit-and-compatibility-evidence",
      "minimumVerification": "L2; foundation components keep an L2-or-L3 floor"
    },
    {
      "id": "major-toolchain-base",
      "criteria": "major version or non-semver foundation change such as an immutable digest, action pin, or managed script revision",
      "default": "isolated-upgrade-task-with-explicit-decision",
      "minimumVerification": "L2-or-L3"
    },
    {
      "id": "prerelease",
      "criteria": "alpha, beta, rc, nightly, canary, or preview",
      "default": "do-not-adopt-outside-an-explicit-experiment",
      "minimumVerification": "isolated-experiment"
    }
  ],
  "exceptionRequiredFields": [
    "component",
    "currentVersion",
    "candidateVersion",
    "reason",
    "securityAndProductImpact",
    "mitigation",
    "owner",
    "reviewDate",
    "exitCondition",
    "rollbackPoint"
  ],
  "exceptions": [],
  "automationBoundary": {
    "automaticDetection": true,
    "automaticReport": true,
    "automaticSecurityAdvisoryCheck": true,
    "automaticMainCommit": false,
    "automaticRelease": false,
    "automaticProductionDeployment": false
  }
}
